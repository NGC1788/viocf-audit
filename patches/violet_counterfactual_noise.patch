     return int(base_seed) + int(sample_index) * int(seed_stride) + int(attempt)
 
 
+def stable_group_seed(base_seed: int, group_key: str, attempt: int = 0) -> int:
+    """Stable seed for a counterfactual block; unlike hash(), this is process-safe."""
+    payload = f"{int(base_seed)}\0{group_key}\0{int(attempt)}".encode("utf-8")
+    digest = hashlib.blake2b(payload, digest_size=8).digest()
+    return int.from_bytes(digest, "little") & ((1 << 63) - 1)
+
